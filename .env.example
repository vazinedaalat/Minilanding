# کپی کنید: cp -n .env.example .env

# پورت انتشار روی هاست (داخل کانتینر همیشه 8080 است)
WEB_PORT=8080

# فقط در زمان build به Vite تزریق می‌شوند
# VITE_SITE_URL = دامنهٔ نهایی برای canonical / Open Graph / JSON-LD
VITE_APP_ENV=production
VITE_APP_NAME=وزین عدالت
VITE_SITE_URL=https://vazinedalat.ir
